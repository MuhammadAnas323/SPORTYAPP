rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared, project-wide channel list. Every signed-in user (the app signs
    // in anonymously per install) can read and write it so a channel added on
    // one device appears on every other device.
    match /connections/{connectionId} {
      allow read, write: if request.auth != null;
    }
  }
}
